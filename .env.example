# ===========================================
# CONFIGURACIÓN DEL BOT DE ARBITRAJE
# ===========================================
# Copia este archivo a .env y completa con tus credenciales reales
# ¡NUNCA compartas tu archivo .env!

# ===========================================
# BINANCE (Exchange Principal)
# ===========================================
# Obtén tus API keys en: https://www.binance.com/en/my/settings/api-management
# Para testnet: https://testnet.binance.vision/
BINANCE_API_KEY=tu_api_key_de_binance
BINANCE_API_SECRET=tu_api_secret_de_binance
BINANCE_TESTNET=true
BINANCE_MIN_ORDER_USDT=5

# ===========================================
# EXCHANGE ARGENTINO PRINCIPAL
# ===========================================
# El bot usará ESTE exchange + Binance como ruta principal
# Pero buscará oportunidades en TODOS los exchanges disponibles
# Opciones: cryptomarket, bitso, ripio, iol
ARGENTINE_EXCHANGE=cryptomarket
ARGENTINE_API_KEY=tu_api_key_exchange_argentino
ARGENTINE_API_SECRET=tu_api_secret_exchange_argentino

# ===========================================
# EXCHANGES ARGENTINOS ADICIONALES
# ===========================================
# El bot comparará precios en TODOS estos exchanges
# para encontrar la mejor ruta de arbitraje
# Completa los que tengas credenciales

# Bitso (https://docs.bitso.com/) - Opera en Argentina
BITSO_API_KEY=tu_api_key_de_bitso
BITSO_API_SECRET=tu_api_secret_de_bitso

# Ripio Trade (https://apidocs.ripiotrade.co/)
RIPIO_API_KEY=tu_api_key_de_ripio
RIPIO_SECRET_KEY=tu_secret_key_de_ripio

# CryptoMarket (https://api.exchange.cryptomkt.com/)
CRYPTOMARKET_API_KEY=tu_api_key_de_cryptomarket
CRYPTOMARKET_SECRET_KEY=tu_secret_key_de_cryptomarket

# IOL InvertirOnline (https://www.invertironline.com/api)
# Requiere: API Key, Secret, Username y Password de tu cuenta
IOL_API_KEY=tu_client_id_de_iol
IOL_API_SECRET=tu_client_secret_de_iol
IOL_USERNAME=tu_username_de_iol
IOL_PASSWORD=tu_password_de_iol

# Bybit (https://www.bybit.com/)
BYBIT_API_KEY=tu_api_key_de_bybit
BYBIT_API_SECRET=tu_api_secret_de_bybit

# OKX (https://www.okx.com/)
# OKX requiere passphrase adicional (lo creas al generar la API key)
OKX_API_KEY=tu_api_key_de_okx
OKX_API_SECRET=tu_api_secret_de_okx
OKX_PASSPHRASE=tu_passphrase_de_okx

# KuCoin (https://www.kucoin.com/)
KUCOIN_API_KEY=tu_api_key_de_kucoin
KUCOIN_API_SECRET=tu_api_secret_de_kucoin

# Gate.io (https://www.gate.io/)
GATEIO_API_KEY=tu_api_key_de_gateio
GATEIO_API_SECRET=tu_api_secret_de_gateio

# Huobi/HTX (https://www.htx.com/)
HUOBI_API_KEY=tu_api_key_de_huobi
HUOBI_API_SECRET=tu_api_secret_de_huobi

# Bitget (https://www.bitget.com/)
BITGET_API_KEY=tu_api_key_de_bitget
BITGET_API_SECRET=tu_api_secret_de_bitget

# MEXC (https://www.mexc.com/)
MEXC_API_KEY=tu_api_key_de_mexc
MEXC_API_SECRET=tu_api_secret_de_mexc

# Crypto.com (https://crypto.com/)
CRYPTO_COM_API_KEY=tu_api_key_de_crypto_com
CRYPTO_COM_API_SECRET=tu_api_secret_de_crypto_com

# ===========================================
# TELEGRAM
# ===========================================
# Crea un bot con @BotFather y obtén tu token
# Obtén tu Chat ID con @userinfobot
TELEGRAM_BOT_TOKEN=tu_token_de_telegram
TELEGRAM_CHAT_ID=tu_chat_id

# ===========================================
# CIFRADO
# ===========================================
# Contraseña maestra para cifrar credenciales
# ¡Elige una contraseña segura y guárdala en un lugar seguro!
ENCRYPTION_PASSWORD=tu_contraseña_maestra_muy_segura

# ===========================================
# CONFIGURACIÓN DE TRADING
# ===========================================
# Capital inicial en USDT (mínimo recomendado: 50 USDT)
INITIAL_CAPITAL_USDT=7

# Número máximo de operaciones simultáneas (1 recomendado para capital bajo)
MAX_POSITIONS=1

# Stop-loss porcentual (5% = 0.05)
STOP_LOSS_PERCENT=5

# Ganancia mínima porcentual para operar
MIN_PROFIT_PERCENT=0.5

# Cooldown entre operaciones en segundos
COOLDOWN_SECONDS=30

# ===========================================
# NOTICIAS
# ===========================================
# Intervalo de chequeo de noticias en segundos
NEWS_CHECK_INTERVAL_SECONDS=300

# Fuentes de noticias (separadas por coma)
NEWS_SOURCES=infobae,clarin,pagina12

# ===========================================
# LOGS
# ===========================================
# Nivel de logging: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Archivo de log
LOG_FILE=data/logs/arbitrage_bot.log

# ===========================================
# ML
# ===========================================
# Ruta para guardar el modelo de ML
ML_MODEL_PATH=data/models/arbitrage_model.pkl

# Intervalo de reentrenamiento en horas
RETRAIN_INTERVAL_HOURS=24
